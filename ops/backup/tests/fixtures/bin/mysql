#!/usr/bin/env bash
# HFP-03 unit test 用の fake mysql client。
# 実 MySQL には接続しない。引数と env だけで決定的に応答する。
# 呼び出し argv は FAKE_ARGV_LOG（設定時）へ行単位で記録する。
set -uo pipefail

if [[ -n "${FAKE_ARGV_LOG:-}" ]]; then
  printf '%s\n' "$*" >> "$FAKE_ARGV_LOG"
fi

query=""
for arg in "$@"; do
  case "$arg" in
    --version)
      printf '%s\n' "${FAKE_CLIENT_VERSION_LINE:-mysql  Ver 8.0.36 for Linux on x86_64 (MySQL Community Server - GPL)}"
      exit 0
      ;;
    --execute|-e)
      query=""
      ;;
    *)
      # --execute=... / -e=... / 直前の --execute の引数 / db名
      if [[ "$arg" == --execute=* ]]; then
        query=${arg#--execute=}
      elif [[ "$arg" == -e=* ]]; then
        query=${arg#-e=}
      elif [[ "$arg" == -e && "${#@}" -gt 0 ]]; then
        continue
      else
        if [[ "${prev:-}" == "--execute" || "${prev:-}" == "-e" ]]; then
          query=$arg
        fi
      fi
      ;;
  esac
  prev=$arg
done

# stdin 経由の query（lock 保持 session 等）
if [[ -z "${query:-}" ]]; then
  IFS= read -r query || true
fi

case "$query" in
  # 内容ハッシュ対象の列情報（lib/content-hash.sh）。FAKE_CONTENT_COLUMNS（「列名<TAB>column_key」の行を
  # printf %b 形式で。既定は主キー id と通常列 name）を返す。
  # FAKE_CONTENT_COLUMNS_EMPTY=1: 出力なしで exit 0（table が無い状態の再現）
  *"ses-backup:content-hash-order"*)
    if [[ -n "${FAKE_CONTENT_COLUMNS_EMPTY:-}" ]]; then
      exit 0
    fi
    printf '%b' "${FAKE_CONTENT_COLUMNS:-id\tPRI\nname\t\n}"
    exit 0
    ;;
  # 内容ハッシュ対象の全行（lib/content-hash.sh）。FAKE_CONTENT_ROWS を printf %b で返す。
  # FAKE_CONTENT_RC=N: 出力なしで exit N（取得失敗の再現）
  *"ses-backup:content-hash */"*)
    if [[ -n "${FAKE_CONTENT_RC:-}" ]]; then
      exit "$FAKE_CONTENT_RC"
    fi
    printf '%b' "${FAKE_CONTENT_ROWS:-1\tfake-content-row\n}"
    exit 0
    ;;
  # target guard の object 数（tables+routines+events 合算）
  *COUNT*table_schema*routines*|*COUNT*routine_schema*|*COUNT*event_schema*)
    if [[ "${FAKE_TABLE_COUNT_FAIL:-0}" == "1" ]]; then
      exit 1
    fi
    if [[ -n "${FAKE_TABLE_COUNT_EMPTY:-}" ]]; then
      exit 0
    fi
    printf '%s\n' "${FAKE_TABLE_COUNT:-0}"
    exit 0
    ;;
  # target guard の table 数: WHERE table_schema = '...' 形式（スペース付き =）
  *COUNT*table_schema*equal*)
    if [[ "${FAKE_TABLE_COUNT_FAIL:-0}" == "1" ]]; then
      exit 1
    fi
    if [[ -n "${FAKE_TABLE_COUNT_EMPTY:-}" ]]; then
      exit 0
    fi
    printf '%s\n' "${FAKE_TABLE_COUNT:-0}"
    exit 0
    ;;
  *COUNT*table_schema\ =\ *)
    if [[ "${FAKE_TABLE_COUNT_FAIL:-0}" == "1" ]]; then
      exit 1
    fi
    if [[ -n "${FAKE_TABLE_COUNT_EMPTY:-}" ]]; then
      exit 0
    fi
    printf '%s\n' "${FAKE_TABLE_COUNT:-0}"
    exit 0
    ;;
  # preflight の engine 検査: table_schema='db'（スペースなし）はこちら
  *information_schema.tables*)
    printf '%s\n' "${FAKE_MYSQL_ENGINES:-InnoDB	5}"
    exit 0
    ;;
  # validate-db の最新 version 取得（成功行の version 全件）。
  # FAKE_FLYWAY_VERSIONS（空白区切り・任意順）があれば 1 行 1 version で返し、
  # 無ければ FAKE_FLYWAY_MAX を 1 行だけ返す。
  # FAKE_FLYWAY_VERSIONS_RC=N: 出力なしで exit N（取得失敗の再現）
  # FAKE_FLYWAY_VERSIONS_EMPTY=1: 出力なしで exit 0（成功行 0 件の再現）
  *SELECT*version*FROM*flyway_schema_history*version*IS*NOT*NULL*)
    if [[ -n "${FAKE_FLYWAY_VERSIONS_RC:-}" ]]; then
      exit "$FAKE_FLYWAY_VERSIONS_RC"
    fi
    if [[ -n "${FAKE_FLYWAY_VERSIONS_EMPTY:-}" ]]; then
      exit 0
    fi
    if [[ -n "${FAKE_FLYWAY_VERSIONS:-}" ]]; then
      # 空白区切りの一覧を 1 行 1 version に分解するため、意図的に分割する。
      # shellcheck disable=SC2086
      for v in $FAKE_FLYWAY_VERSIONS; do printf '%s\n' "$v"; done
    else
      printf '%s\n' "${FAKE_FLYWAY_MAX:-42}"
    fi
    exit 0
    ;;
  # 旧方式 MAX(version) を実 MySQL と同じ辞書順で再現する（VARCHAR の MAX）。
  # 0 件なら NULL。修正前の実装をテストで検出できるようにするための応答。
  *MAX*version*FROM*flyway_schema_history*)
    if [[ -n "${FAKE_FLYWAY_VERSIONS_EMPTY:-}" ]]; then
      printf '%s\n' NULL
    elif [[ -n "${FAKE_FLYWAY_VERSIONS:-}" ]]; then
      # shellcheck disable=SC2086
      printf '%s\n' $FAKE_FLYWAY_VERSIONS | LC_ALL=C sort | tail -n 1
    else
      printf '%s\n' "${FAKE_FLYWAY_MAX:-42}"
    fi
    exit 0
    ;;
  *flyway_schema_history*success*)
    printf '%s\n' "${FAKE_FLYWAY_FAILED:-0}"
    exit 0
    ;;
  *marker-after*)
    printf '%s\n' "${FAKE_MARKER_AFTER:-0}"
    exit 0
    ;;
  *marker-before*)
    printf '%s\n' "${FAKE_MARKER_BEFORE:-1}"
    exit 0
    ;;
  *CHECK*TABLE*)
    printf '%s\n' "${FAKE_CHECK_TABLE:-OK}"
    exit 0
    ;;
  *storage_key*|*stored_name*|*pdf_path*|*signed_pdf_path*|*certificate_path*|*skill_sheet_path*)
    printf '%s\n' "${FAKE_REF_KEYS:-}"
    exit 0
    ;;
  *COUNT*)
    printf '%s\n' "${FAKE_COUNT:-0}"
    exit 0
    ;;
  *SELECT*@@version*)
    printf '%s\n' "${FAKE_MYSQL_STATUS_ROW:-8.0.36	11111111-2222-3333-4444-555555555555	1	ROW	CRC32	0	ON	YES	/var/lib/mysql/binlog.000001	2592000}"
    exit 0
    ;;
  *@@server_uuid*)
    printf '%s\n' "${FAKE_UUID:-11111111-2222-3333-4444-555555555555}"
    exit 0
    ;;
  *GET_LOCK*)
    printf '%s\n' "${FAKE_GET_LOCK:-1}"
    # lock 保持 session を模す（release まで接続維持）
    if [[ "${FAKE_GET_LOCK_HOLD:-0}" == "1" && "${FAKE_GET_LOCK:-1}" == "1" ]]; then
      while :; do sleep 1; done
    fi
    exit 0
    ;;
  *RELEASE_LOCK*)
    printf '%s\n' "${FAKE_RELEASE_LOCK:-1}"
    exit 0
    ;;
  *FLUSH*BINARY*LOGS*)
    # rotation: state file に新しい binlog を追記する（接頭辞を保持）
    local_state=${FAKE_BINLOG_STATE:-}
    if [[ -n "$local_state" && -f "$local_state" ]]; then
      last=$(tail -n1 "$local_state" | cut -f1)
      prefix=${last%.*}
      suf=${last##*.}
      width=${#suf}
      n=$((10#$suf + 1))
      printf "%s.%0${width}d\t157\n" "$prefix" "$n" >> "$local_state"
    fi
    exit "${FAKE_FLUSH_RC:-0}"
    ;;
  *SHOW*BINARY*LOGS*)
    if [[ -n "${FAKE_BINLOG_STATE:-}" && -f "$FAKE_BINLOG_STATE" ]]; then
      cat "$FAKE_BINLOG_STATE"
    else
      printf '%b' "${FAKE_SHOW_BINARY_LOGS:-binlog.000001\t180\nbinlog.000002\t200}"
    fi
    exit 0
    ;;
  *ses_recovery_control.targets*)
    # 空文字を明示指定できるよう `:-` ではなく `-` を使う
    printf '%s\n' "${FAKE_CONTROL_MARKER-default	plan-1234}"
    exit 0
    ;;
  *CREATE*DATABASE*)
    exit 0
    ;;
  *RESET*MASTER*)
    # R1 P0-01: 再 restore の GTID リセット（restore.sh が import 前に発行）
    printf '%s\n' "$*" >> "${FAKE_RESET_MASTER_LOG:-/dev/null}"
    exit "${FAKE_RESET_MASTER_RC:-0}"
    ;;
  *MySQL\ dump*|--*)
    # dump import（stdin の先頭行が SQL コメント）は成功として扱う
    exit 0
    ;;
  "")
    # stdin からの import / replay は成功として扱う（argv は記録済み）
    exit 0
    ;;
  *)
    echo "fake-mysql: 未知の query: $query" >&2
    exit 9
    ;;
esac
