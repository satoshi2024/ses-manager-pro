<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.ses</groupId>
    <artifactId>ses-manager-pro</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>SES Manager Pro</name>
    <description>日本SES企業向け社内管理システム</description>

    <properties>
        <java.version>17</java.version>
        <mybatis-plus.version>3.5.7</mybatis-plus.version>
        <shedlock.version>5.10.2</shedlock.version>
        <caffeine.version>3.1.8</caffeine.version>
        <testcontainers.version>1.20.6</testcontainers.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- 既定のmvn testは高速feedback用。実MySQL/performance/実Chrome(browser)は明示profileで実行する。 -->
        <test.groups></test.groups>
        <test.excluded-groups>mysql | performance | browser</test.excluded-groups>
        <junit.parallel.enabled>false</junit.parallel.enabled>
        <junit.parallel.mode.default>same_thread</junit.parallel.mode.default>
        <junit.parallel.mode.classes>same_thread</junit.parallel.mode.classes>
        <junit.parallel.parallelism>1</junit.parallel.parallelism>
        <!-- JaCoCoのprepare-agentが差し込むJVM引数の受け皿。surefireの<argLine>で@{jacocoArgLine}として
             展開する。JaCoCoをskipした場合でも未解決にならないよう既定値を空で定義しておく。 -->
        <jacocoArgLine></jacocoArgLine>
    </properties>

    <dependencies>
        <!-- ========== Spring Boot コア ========== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-client</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- ========== Actuator（監視: health + Prometheus + K8s liveness/readiness） ==========
             ACC-OPS-P0-001 / ACC-OPS-P1-002: exposure は health と prometheus のみ。
             env/beans/configprops/heapdump/mappings は公開しない。prometheus は SecurityConfig で
             認証必須（匿名 permitAll にしない）。バージョンは spring-boot-starter-parent 管理。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- Webhook IPピン留め用（Host/SNIは元ホストのまま、DNSだけ検証済みIPへ固定）。
             sun.net.http.allowRestrictedHeaders は使わない（REV-B2-P1-002）。 -->
        <dependency>
            <groupId>org.apache.httpcomponents.client5</groupId>
            <artifactId>httpclient5</artifactId>
        </dependency>

        <!-- Thymeleaf + Security 連携 -->
        <dependency>
            <groupId>org.thymeleaf.extras</groupId>
            <artifactId>thymeleaf-extras-springsecurity6</artifactId>
        </dependency>

        <!-- Thymeleaf レイアウトダイアレクト -->
        <dependency>
            <groupId>nz.net.ultraq.thymeleaf</groupId>
            <artifactId>thymeleaf-layout-dialect</artifactId>
        </dependency>

        <!-- ========== MyBatis Plus (Spring Boot 3対応) ========== -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>

        <!-- ========== ShedLock（バッチの多重起動防止） ==========
             複数インスタンス構成では @Scheduled が全インスタンスで同時に走るため、
             DBの共有ロックで1インスタンスのみ実行させる。 -->
        <dependency>
            <groupId>net.javacrumbs.shedlock</groupId>
            <artifactId>shedlock-spring</artifactId>
            <version>${shedlock.version}</version>
        </dependency>
        <dependency>
            <groupId>net.javacrumbs.shedlock</groupId>
            <artifactId>shedlock-provider-jdbc-template</artifactId>
            <version>${shedlock.version}</version>
        </dependency>

        <!-- ========== Caffeine（ダッシュボード集計のキャッシュ） ========== -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
            <version>${caffeine.version}</version>
        </dependency>

        <!-- ========== MySQL ========== -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ========== Flyway (DBマイグレーション管理) ========== -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <!-- H2 Database (for local rapid prototyping) -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ========== PDF生成 (スキルシート用) ========== -->
        <dependency>
            <groupId>com.github.librepdf</groupId>
            <artifactId>openpdf</artifactId>
            <version>2.0.2</version>
        </dependency>

        <!-- ========== Excel生成 (帳票出力用) ========== -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.2.5</version>
        </dependency>

        <!-- ========== Lombok ========== -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ========== 開発ツール ========== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <!-- ========== テスト ========== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Testcontainers: 実MySQL上でFlywayマイグレーションを検証するスモークテスト用。
             Docker不在の環境では @Testcontainers(disabledWithoutDocker=true) により自動スキップされる。

             バージョンは下の testcontainers-bom で一括管理する。モジュールだけを個別指定すると
             spring-boot-starter-parent の BOM が持つ core(1.19.8) と混在するため。
             なお同梱の docker-java は版によらず既定APIバージョン1.32で接続しにいくので、
             MinAPIVersion 1.40 の新しいDocker Engine（29系）では 400 "client version 1.32 is too old"
             となり、Dockerが動いていてもTestcontainersが「Dockerなし」と判断してsmokeが黙ってskipされる。
             これを避けるため surefire で api.version を明示している（下記 maven-surefire-plugin）。 -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>mysql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!-- docker-java が要求するDocker APIバージョンを明示する。
                 既定は1.32固定で、Docker Engine 29系(MinAPIVersion 1.40)が接続を拒否するため、
                 Dockerが起動していてもMySQL smoke(FlywayMigrationSmokeTest 等)が
                 "Docker is not available" として黙ってskipされてしまう。
                 1.40はDocker 19.03相当で、現役のどのEngineでも受け付けられる下限。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- 固定順序（alphabetical/filesystem）は隔離の代替にしない。
                         隔離は @Transactional ロールバックまたは mysql タグ。
                         乱数 seed は -Dsurefire.runOrder.random.seed=N で再現可能。 -->
                    <runOrder>random</runOrder>
                    <!-- タイムゾーン/ロケール/文字コードを本番設定(application.ymlのAsia/Tokyo・日本語)へ固定する。
                         未固定だとローカル(JST・ja_JP・環境依存のfile.encoding)とCI(UTC・en_US)で
                         日付境界やメッセージ解決が食い違う。@{jacocoArgLine}はカバレッジ計測用エージェント。 -->
                    <argLine>@{jacocoArgLine} -Duser.timezone=Asia/Tokyo -Duser.language=ja -Duser.country=JP -Dfile.encoding=UTF-8</argLine>
                    <systemPropertyVariables>
                        <api.version>1.40</api.version>
                        <junit.jupiter.execution.parallel.enabled>${junit.parallel.enabled}</junit.jupiter.execution.parallel.enabled>
                        <junit.jupiter.execution.parallel.mode.default>${junit.parallel.mode.default}</junit.jupiter.execution.parallel.mode.default>
                        <junit.jupiter.execution.parallel.mode.classes.default>${junit.parallel.mode.classes}</junit.jupiter.execution.parallel.mode.classes.default>
                        <junit.jupiter.execution.parallel.config.strategy>fixed</junit.jupiter.execution.parallel.config.strategy>
                        <junit.jupiter.execution.parallel.config.fixed.parallelism>${junit.parallel.parallelism}</junit.jupiter.execution.parallel.config.fixed.parallelism>
                        <!-- test側がdev profileを明示しても大量のSQL DEBUG logを再有効化させない。 -->
                        <logging.level.com.ses.mapper>WARN</logging.level.com.ses.mapper>
                        <logging.level.com.baomidou.mybatisplus>WARN</logging.level.com.baomidou.mybatisplus>
                        <logging.level.org.flywaydb>WARN</logging.level.org.flywaydb>
                    </systemPropertyVariables>
                    <groups>${test.groups}</groups>
                    <excludedGroups>${test.excluded-groups}</excludedGroups>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.ses.SesManagerApplication</mainClass>
                    <!-- ローカル開発起動は dev プロファイルを明示付与する（application.yml に既定profileを置かないため）。
                         本番は SPRING_PROFILES_ACTIVE=prod を環境変数で指定すること（ACC-SEC-P1-007）。 -->
                    <profiles>
                        <profile>dev</profile>
                    </profiles>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-maven-plugin</artifactId>
                <configuration>
                    <url>${env.DB_URL}</url>
                    <user>${env.DB_USERNAME}</user>
                    <password>${env.DB_PASSWORD}</password>
                    <locations>
                        <location>filesystem:src/main/resources/db/migration</location>
                    </locations>
                    <baselineOnMigrate>true</baselineOnMigrate>
                    <baselineVersion>9</baselineVersion>
                    <baselineDescription>手動SQL(001-009)適用済みベースライン</baselineDescription>
                </configuration>
            </plugin>
            <!-- JaCoCo Code Coverage Plugin -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <configuration>
                    <excludes>
                        <exclude>com/ses/dto/**</exclude>
                        <exclude>com/ses/entity/**</exclude>
                        <exclude>com/ses/*Application.class</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                        <configuration>
                            <!-- surefireの<argLine>を上書きせず、専用プロパティへ入れて@{jacocoArgLine}で合成する -->
                            <propertyName>jacocoArgLine</propertyName>
                        </configuration>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Docker必須の実MySQL test。profile内は逐次実行し、CIでは独立jobへ分割して安全に並列化する。 -->
        <profile>
            <id>mysql-tests</id>
            <properties>
                <test.groups>mysql</test.groups>
                <test.excluded-groups>__none__</test.excluded-groups>
            </properties>
        </profile>

        <!-- wall-clock/heap計測はJaCoCo instrumentationの影響を除いて単独実行する。 -->
        <profile>
            <id>performance-tests</id>
            <properties>
                <test.groups>performance</test.groups>
                <test.excluded-groups>__none__</test.excluded-groups>
                <jacoco.skip>true</jacoco.skip>
            </properties>
        </profile>

        <!-- ローカルでCI対象を1commandで再現するための逐次full suite。 -->
        <profile>
            <id>full-tests</id>
            <properties>
                <test.groups></test.groups>
                <test.excluded-groups>__none__</test.excluded-groups>
            </properties>
        </profile>

        <!-- 実Chrome（CDP・headless）必須のbrowser Demo。default fast suiteへは無条件追加しない。 -->
        <profile>
            <id>browser-tests</id>
            <properties>
                <test.groups>browser</test.groups>
                <test.excluded-groups>__none__</test.excluded-groups>
                <jacoco.skip>true</jacoco.skip>
            </properties>
        </profile>
    </profiles>
</project>
